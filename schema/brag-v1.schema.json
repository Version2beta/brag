    "documentation_evidence": {"type":"object","required":["status","method","limits","snapshots","comparisons","limitations"],"properties":{"status":{"enum":["measured","partial","failed","unavailable"]},"method":{"type":"string"},"limits":{"type":"string"},"snapshots":{"type":"array","items":{"$ref":"#/$defs/doc_snapshot"}},"comparisons":{"type":"array","items":{"$ref":"#/$defs/doc_comparison"}},"limitations":{"type":"array","items":{"type":"string"}}}},
    "engineering_evidence": {"type":"object","required":["algorithm_version","scope","complexity","test_inventory","documentation","architecture","security","duplication"],"properties":{"algorithm_version":{"type":"string"},"scope":{"type":"string"},"complexity":{"$ref":"#/$defs/complexity_evidence"},"test_inventory":{"$ref":"#/$defs/test_evidence"},"documentation":{"$ref":"#/$defs/documentation_evidence"},"architecture":{"$ref":"#/$defs/architecture_evidence"},"security":{"$ref":"#/$defs/security_evidence"},"duplication":{"$ref":"#/$defs/engineering_metric"}}},
    "integer_distribution": {"type":"object","required":["count","min","median","p95","max"],"properties":{"count":{"type":"integer","minimum":0},"min":{"type":"integer","minimum":0},"median":{"type":"integer","minimum":0},"p95":{"type":"integer","minimum":0},"max":{"type":"integer","minimum":0}}},
    "package_node": {"type":"object","required":["import_path","package_name","direct_internal_dependencies","direct_external_dependencies","test_only_imports","direct_fan_in","direct_fan_out","transitive_only_dependency_count"],"properties":{"import_path":{"type":"string"},"package_name":{"type":"string"},"direct_internal_dependencies":{"type":"array","items":{"type":"string"}},"direct_external_dependencies":{"type":"array","items":{"type":"string"}},"test_only_imports":{"type":"array","items":{"type":"string"}},"direct_fan_in":{"type":"integer","minimum":0},"direct_fan_out":{"type":"integer","minimum":0},"transitive_only_dependency_count":{"type":"integer","minimum":0}}},
    "architecture_snapshot": {"type":"object","required":["status","snapshot","module_path","package_count","direct_internal_edge_count","direct_external_edge_count","transitive_only_package_dependency_count","direct_fan_in_distribution","direct_fan_out_distribution","direct_internal_dependency_distribution","direct_external_dependency_distribution","transitive_dependency_distribution","cyclic_package_components","packages","packages_truncated","limitations"],"properties":{"status":{"enum":["measured","partial","failed","unavailable"]},"snapshot":{"type":"string"},"module_path":{"type":"string"},"package_count":{"type":"integer","minimum":0},"direct_internal_edge_count":{"type":"integer","minimum":0},"direct_external_edge_count":{"type":"integer","minimum":0},"transitive_only_package_dependency_count":{"type":"integer","minimum":0},"direct_fan_in_distribution":{"$ref":"#/$defs/integer_distribution"},"direct_fan_out_distribution":{"$ref":"#/$defs/integer_distribution"},"direct_internal_dependency_distribution":{"$ref":"#/$defs/integer_distribution"},"direct_external_dependency_distribution":{"$ref":"#/$defs/integer_distribution"},"transitive_dependency_distribution":{"$ref":"#/$defs/integer_distribution"},"cyclic_package_components":{"type":"array","items":{"type":"array","items":{"type":"string"}}},"packages":{"type":"array","items":{"$ref":"#/$defs/package_node"}},"packages_truncated":{"type":"boolean"},"parse_failures":{"type":"array","items":{"type":"string"}},"unresolved_internal_imports":{"type":"array","items":{"type":"string"}},"limitations":{"type":"array","items":{"type":"string"}}}},
    "architecture_change": {"type":"object","required":["kind","package"],"properties":{"kind":{"type":"string"},"package":{"type":"string"},"dependency":{"type":"string"}}},
    "architecture_comparison": {"type":"object","required":["from","to","packages_added","packages_removed","direct_internal_edges_added","direct_internal_edges_removed","direct_external_edges_added","direct_external_edges_removed","details","details_truncated"],"properties":{"from":{"type":"string"},"to":{"type":"string"},"packages_added":{"type":"integer","minimum":0},"packages_removed":{"type":"integer","minimum":0},"direct_internal_edges_added":{"type":"integer","minimum":0},"direct_internal_edges_removed":{"type":"integer","minimum":0},"direct_external_edges_added":{"type":"integer","minimum":0},"direct_external_edges_removed":{"type":"integer","minimum":0},"details":{"type":"array","items":{"$ref":"#/$defs/architecture_change"}},"details_truncated":{"type":"boolean"}}},
    "architecture_evidence": {"type":"object","required":["status","method","snapshots","comparisons","limits","limitations"],"properties":{"status":{"enum":["measured","partial","failed","unavailable"]},"method":{"type":"string"},"snapshots":{"type":"array","items":{"$ref":"#/$defs/architecture_snapshot"}},"comparisons":{"type":"array","items":{"$ref":"#/$defs/architecture_comparison"}},"limits":{"type":"string"},"limitations":{"type":"array","items":{"type":"string"}}}},
