    "attributed_ratio": {"type":"object","required":["status","denominator","denominator_unit","reason"],"properties":{"status":{"enum":["measured","unavailable","partial"]},"numerator":{"type":["integer","null"],"minimum":0},"denominator":{"type":"integer","minimum":0},"denominator_unit":{"type":"string"},"reason":{"type":"string"}}},
