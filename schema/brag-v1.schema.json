    "security_indicator": {"type":"object","required":["kind","path","line","evidence"],"properties":{"kind":{"type":"string"},"path":{"type":"string"},"line":{"type":"integer","minimum":0},"evidence":{"type":"string"}}},
    "security_snapshot": {"type":"object","required":["status","snapshot","dependencies","indicator_counts","indicators","indicators_truncated"],"properties":{"status":{"enum":["measured","partial","failed","unavailable"]},"snapshot":{"type":"string"},"dependencies":{"type":"array","items":{"$ref":"#/$defs/dependency_decl"}},"indicator_counts":{"type":"object","additionalProperties":{"type":"integer","minimum":0}},"indicators":{"type":"array","items":{"$ref":"#/$defs/security_indicator"}},"indicators_truncated":{"type":"boolean"},"parse_failures":{"type":"array","items":{"type":"string"}}}},
