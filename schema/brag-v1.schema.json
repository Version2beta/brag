{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:brag:schema:v1",
  "title": "BRAG report schema v1",
  "type": "object",
  "required": ["schema_version","tool_version","config_version","repository","scope","head","base","history","selected_identity","working_tree_state_identity","working_tree_state_method","attribution","contributors","repository_measures","net_source_change","selected_contributor","measures","working_tree","unavailable","warnings"],
  "properties": {
    "schema_version": {"const":1},
    "tool_version": {"type":"string"},
    "config_version": {"type":"integer"},
    "repository": {"const":"."},
    "scope": {"enum":["branch","all"]},
    "head": {"type":"string"},
    "base": {"oneOf":[{"type":"null"},{"$ref":"#/$defs/base"}]},
    "history": {"$ref":"#/$defs/history"},
    "selected_identity": {"$ref":"#/$defs/identity"},
    "working_tree_state_identity": {"type":"string"},
    "working_tree_state_method": {"type":"string"},
    "attribution": {"$ref":"#/$defs/attribution"},
    "contributors": {"type":"array","items":{"$ref":"#/$defs/person"}},
    "repository_measures": {"$ref":"#/$defs/repository_measures"},
    "net_source_change": {"oneOf":[{"type":"null"},{"$ref":"#/$defs/net_change"}]},
    "selected_contributor": {"oneOf":[{"type":"null"},{"$ref":"#/$defs/selected"}]},
    "measures": {"$ref":"#/$defs/measures"},
    "working_tree": {"$ref":"#/$defs/working_tree"},
    "unavailable": {"type":"object","additionalProperties":{"$ref":"#/$defs/unavailable"}},
    "warnings": {"type":"array","items":{"type":"string"}}
  },
  "$defs": {
    "identity": {"type":"object","required":["name","email","available"],"properties":{"name":{"type":"string"},"email":{"type":"string"},"available":{"type":"boolean"}}},
    "base": {"type":"object","required":["ref","commit","merge_base","provenance"],"properties":{"ref":{"type":"string"},"commit":{"type":"string"},"merge_base":{"type":"string"},"provenance":{"type":"string"}}},
    "history": {"type":"object","required":["included_commit_ids","boundary"],"properties":{"included_commit_ids":{"type":"array","items":{"type":"string"}},"boundary":{"type":"string"}}},
    "counts": {"type":"object","required":["lines_added","lines_deleted","source_lines_added","source_lines_deleted"],"properties":{"lines_added":{"type":"integer"},"lines_deleted":{"type":"integer"},"source_lines_added":{"type":"integer"},"source_lines_deleted":{"type":"integer"}}},
    "ratio": {"type":"object","required":["numerator","denominator","value"],"properties":{"numerator":{"type":"integer"},"denominator":{"type":"integer"},"value":{"type":["number","null"]}}},
    "person": {"type":"object","required":["name","email","author_commits","coauthor_commits","lines_added","lines_deleted","source_lines_added","source_lines_deleted","author_commit_ratio"],"properties":{"name":{"type":"string"},"email":{"type":"string"},"author_commits":{"type":"integer"},"coauthor_commits":{"type":"integer"},"lines_added":{"type":"integer"},"lines_deleted":{"type":"integer"},"source_lines_added":{"type":"integer"},"source_lines_deleted":{"type":"integer"},"author_commit_ratio":{"$ref":"#/$defs/ratio"}}},
    "attribution": {"type":"object","required":["author_commits","coauthor_commits"],"properties":{"author_commits":{"type":"integer"},"coauthor_commits":{"type":"integer"}}},
