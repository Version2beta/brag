    "net_change": {"type":"object","required":["status","baseline","source_lines_added","source_lines_deleted","net_source_lines","method"],"properties":{"status":{"const":"available"},"baseline":{"type":"string"},"source_lines_added":{"type":"integer"},"source_lines_deleted":{"type":"integer"},"net_source_lines":{"type":"integer"},"method":{"type":"string"}}},
    "selected": {"type":"object","required":["author_commits","coauthor_commits","author_commit_ratio","cumulative_churn"],"properties":{"author_commits":{"type":"integer"},"coauthor_commits":{"type":"integer"},"author_commit_ratio":{"$ref":"#/$defs/ratio"},"cumulative_churn":{"$ref":"#/$defs/counts"}}},
    "measures": {"type":"object","required":["commit_method","overlay_method","ratio_denominator","source_extensions"],"properties":{"commit_method":{"type":"string"},"overlay_method":{"type":"string"},"ratio_denominator":{"type":"string"},"source_extensions":{"type":"array","items":{"type":"string"}}}},
    "working_tree": {"type":"object","required":["status","counts","tracked_paths_changed","untracked_files_present"],"properties":{"status":{"type":"string"},"counts":{"$ref":"#/$defs/counts"},"tracked_paths_changed":{"type":"integer"},"untracked_files_present":{"type":"boolean"}}},
    "unavailable": {"type":"object","required":["status","reason"],"properties":{"status":{"const":"unavailable"},"reason":{"type":"string"}}},
    "engineering_metric": {"type":"object","required":["status","method"],"properties":{"status":{"enum":["measured","unavailable","unsupported","failed","partial"]},"method":{"type":"string"},"units":{"type":"string"},"count":{"type":"integer","minimum":0},"reason":{"type":"string"},"warnings":{"type":"array","items":{"type":"string"}}}},
    "complexity_distribution": {"type":"object","required":["count","median","p95","max","top_decile_share","threshold","threshold_exceedances"],"properties":{"count":{"type":"integer","minimum":0},"median":{"type":"integer"},"p95":{"type":"integer"},"max":{"type":"integer"},"top_decile_share":{"type":"number","minimum":0,"maximum":1},"threshold":{"type":"integer"},"threshold_exceedances":{"type":"integer","minimum":0}}},
    "complexity_snapshot": {"type":"object","required":["status","snapshot","function_count","distributions","skipped_files","truncated"],"properties":{"status":{"enum":["measured","partial","failed","unavailable"]},"snapshot":{"type":"string"},"function_count":{"type":"integer","minimum":0},"distributions":{"type":"object","additionalProperties":{"$ref":"#/$defs/complexity_distribution"}},"parse_failures":{"type":"array","items":{"type":"string"}},"skipped_files":{"type":"integer","minimum":0},"truncated":{"type":"boolean"}}},
    "function_change": {"type":"object","required":["key","change"],"properties":{"key":{"type":"string"},"change":{"enum":["added","removed","modified"]},"before":{"$ref":"#/$defs/function_metrics"},"after":{"$ref":"#/$defs/function_metrics"}}},
    "function_metrics": {"type":"object","required":["cyclomatic","cognitive","max_control_nesting","physical_function_lines"],"properties":{"cyclomatic":{"type":"integer"},"cognitive":{"type":"integer"},"max_control_nesting":{"type":"integer"},"physical_function_lines":{"type":"integer"}}},
    "complexity_comparison": {"type":"object","required":["from","to","added_functions","removed_functions","modified_functions","unchanged_functions","matched_complexity_changed","identity_ambiguity","changed_function_details","details_truncated"],"properties":{"from":{"type":"string"},"to":{"type":"string"},"added_functions":{"type":"integer"},"removed_functions":{"type":"integer"},"modified_functions":{"type":"integer"},"unchanged_functions":{"type":"integer"},"matched_complexity_changed":{"type":"integer"},"identity_ambiguity":{"type":"string"},"changed_function_details":{"type":"array","items":{"$ref":"#/$defs/function_change"}},"details_truncated":{"type":"boolean"}}},
    "complexity_evidence": {"type":"object","required":["status","method","algorithm","snapshots","comparisons","limits","limitations"],"properties":{"status":{"enum":["measured","partial","failed","unavailable"]},"method":{"type":"string"},"algorithm":{"type":"string"},"snapshots":{"type":"array","items":{"$ref":"#/$defs/complexity_snapshot"}},"comparisons":{"type":"array","items":{"$ref":"#/$defs/complexity_comparison"}},"limits":{"type":"string"},"limitations":{"type":"array","items":{"type":"string"}}}},
    "test_definition": {"type":"object","required":["key","kind","definition_hash"],"properties":{"key":{"type":"string"},"kind":{"enum":["test","test_main","benchmark","example"]},"definition_hash":{"type":"string"}}},
