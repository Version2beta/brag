    "security_comparison": {"type":"object","required":["from","to","dependencies_added","dependencies_removed","dependencies_modified","dependency_changes","details_truncated"],"properties":{"from":{"type":"string"},"to":{"type":"string"},"dependencies_added":{"type":"integer","minimum":0},"dependencies_removed":{"type":"integer","minimum":0},"dependencies_modified":{"type":"integer","minimum":0},"dependency_changes":{"type":"array","items":{"$ref":"#/$defs/dependency_change"}},"details_truncated":{"type":"boolean"}}},
