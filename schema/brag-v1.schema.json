    "security_evidence": {"type":"object","required":["status","method","snapshots","comparisons","vulnerability_scanner","limits","limitations"],"properties":{"status":{"enum":["measured","partial","failed","unavailable"]},"method":{"type":"string"},"snapshots":{"type":"array","items":{"$ref":"#/$defs/security_snapshot"}},"comparisons":{"type":"array","items":{"$ref":"#/$defs/security_comparison"}},"vulnerability_scanner":{"$ref":"#/$defs/scanner_status"},"limits":{"type":"string"},"limitations":{"type":"array","items":{"type":"string"}}}}
  }
