    "doc_snapshot": {"type":"object","required":["status","snapshot","method","counts","files_truncated"],"properties":{"status":{"enum":["measured","partial","failed"]},"snapshot":{"type":"string"},"method":{"type":"string"},"counts":{"$ref":"#/$defs/doc_counts"},"files_truncated":{"type":"boolean"}}},
